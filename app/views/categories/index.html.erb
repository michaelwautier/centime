<% content_for :title, "Categories · Centime" %>

<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-bold">Categories</h1>
  <%= link_to "New category", new_category_path,
        class: "rounded-md bg-emerald-600 px-4 py-2 text-sm font-medium text-white hover:bg-emerald-700" %>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
  <% { "income" => "Income", "expense" => "Expenses" }.each do |kind, heading| %>
    <div class="rounded-lg bg-white border border-gray-200">
      <h2 class="text-sm font-medium text-gray-700 px-5 py-4 border-b border-gray-100"><%= heading %></h2>
      <ul>
        <% @categories.select { |category| category.kind == kind }.each do |category| %>
          <li class="flex items-center justify-between px-5 py-3 border-b border-gray-50 last:border-0">
            <div class="flex items-center gap-3">
              <span class="inline-block h-3 w-3 rounded-full" style="background-color: <%= category.color %>"></span>
              <span class="text-sm text-gray-900"><%= category.name %></span>
            </div>
            <div class="text-xs">
              <%= link_to "Edit", edit_category_path(category), class: "text-gray-400 hover:text-gray-700" %>
              <%= button_to "Archive", category_path(category), method: :delete,
                    form: { data: { turbo_confirm: "Archive #{category.name}? Existing transactions keep it." }, class: "inline" },
                    class: "text-gray-400 hover:text-red-600 ml-2" %>
            </div>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>
</div>
