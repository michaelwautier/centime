<%= form_with model: form, url: url, method: method, class: "space-y-5 max-w-lg" do |f| %>
  <% if form.errors.any? %>
    <div class="rounded-md bg-red-50 px-4 py-3 text-sm text-red-800">
      <ul class="list-disc pl-4">
        <% form.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="flex gap-3">
    <% TransactionForm::DIRECTIONS.each do |direction| %>
      <label class="flex items-center gap-2 text-sm">
        <%= f.radio_button :direction, direction, class: "text-emerald-600" %>
        <%= direction.capitalize %>
      </label>
    <% end %>
  </div>

  <div>
    <%= f.label :amount, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.number_field :amount, step: "0.01", min: "0.01", required: true, inputmode: "decimal",
          class: "w-full rounded-md border-gray-300" %>
  </div>

  <div>
    <%= f.label :booked_on, "Date", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.date_field :booked_on, required: true, class: "w-full rounded-md border-gray-300" %>
  </div>

  <div>
    <%= f.label :merchant_name, "Merchant", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :merchant_name, class: "w-full rounded-md border-gray-300" %>
  </div>

  <div>
    <%= f.label :description, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :description, class: "w-full rounded-md border-gray-300" %>
  </div>

  <div>
    <%= f.label :category_id, "Category", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.collection_select :category_id, form.user.categories.active.ordered, :id, :name,
          { include_blank: "Uncategorized" }, class: "w-full rounded-md border-gray-300" %>
  </div>

  <div class="flex items-center gap-3">
    <%= f.submit class: "rounded-md bg-emerald-600 px-4 py-2 text-sm font-medium text-white hover:bg-emerald-700 cursor-pointer" %>
    <%= link_to "Cancel", transactions_path, class: "text-sm text-gray-500 hover:text-gray-800" %>
  </div>
<% end %>
